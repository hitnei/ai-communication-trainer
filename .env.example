# Copy to .env.local and fill in. Without GEMINI_API_KEY the app runs on a
# deterministic mock AI provider so the full loop still works offline.

# Gemini (server-side only - never exposed to the browser)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# ai provider selection: auto (default) | gemini | mock
AI_PROVIDER=auto

# Local-first storage
DATABASE_PATH=./.data/app.db
AUDIO_STORAGE_DIR=./.data/audio

LOG_LEVEL=info
